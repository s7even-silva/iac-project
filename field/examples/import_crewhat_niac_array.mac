# Run from geant4/ActiveShield_Sim/build after generating the NIAC layout
# (field/examples/crewhat_niac_array.json -> generate_ellipse_array.py ->
# generate_mesh.py -> mesh_to_gdml.py into field/generated/crewhat_niac_array).
# Checks import, overlaps with hull/cabin/other coils (CheckOverlaps) and the
# mass printed per coil (15.6 t each, plan_piloto.md D9). No field: magnetic
# checks are done on the Biot-Savart/Elmer side. Initialization only: the
# primary generator is the project's own /gun, not GPS.
/run/numberOfThreads 1
/spacecraft/worldHalfSize 14 m
/spacecraft/shipRadius 4.5 m
/spacecraft/shipHalfLength 5 m
/spacecraft/coilGeometry ../../../field/generated/crewhat_niac_array/halbach_array.gdml
/phantom/setPhantomSex male
/phantom/setPhantomSection head
/run/initialize
