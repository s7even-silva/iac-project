/run/numberOfThreads 1

# Double Helix pilot coil (field/examples/dh_pilot.json) + its regularized
# Biot-Savart reference field map, both generated by field/generate_dh.py
# -> field/mesh_swept.py -> field/mesh_to_gdml.py and field/compute_field.py
# respectively. Neither is Geom14 or a validated magnet design (see
# field/GEOM14_STATUS.md) -- this is a pipeline smoke test: does Geant4
# import the coil geometry and read the field map without overlaps or
# errors, and does a beam through the field behave sanely.
#
# Geant4 macros require absolute paths here (no repo-relative resolution),
# and field/generated/ is gitignored (regenerated, not versioned -- see
# AGENTS.md), so the paths below must be regenerated and edited to match
# YOUR checkout before running this macro:
#   field/.venv/bin/python3 field/generate_dh.py field/examples/dh_pilot.json field/generated/geant4_pilot
#   field/.venv/bin/python3 field/mesh_swept.py field/generated/geant4_pilot/current_path.json field/generated/geant4_pilot/dh.msh
#   field/.venv/bin/python3 field/mesh_to_gdml.py field/generated/geant4_pilot/dh.msh field/generated/geant4_pilot/materials.json field/generated/geant4_pilot/dh.gdml
#   field/.venv/bin/python3 field/compute_field.py field/generated/geant4_pilot/current_path.json field/generated/geant4_pilot/dh.map --half-size 10 --spacing 0.5
#
# PreInit commands must come before /run/initialize.
/spacecraft/coilGeometry /ABSOLUTE/PATH/TO/iac-project/field/generated/geant4_pilot/dh.gdml
/spacecraft/fieldMap /ABSOLUTE/PATH/TO/iac-project/field/generated/geant4_pilot/dh.map
/spacecraft/fieldScale 1
# Matches the default (10 m) and the field map's own half-size; set
# explicitly so this macro stays correct if either default changes.
/spacecraft/worldHalfSize 10 m

/phantom/setPhantomSex male
/phantom/setPhantomSection head

/run/initialize

# Test beam: ICRP110PhantomPrimaryGeneratorAction no longer wraps GPS
# (rewritten 2026-09-10) -- position/direction are sampled isotropically
# over a sphere enclosing the whole spacecraft, not aimed through the
# axis as the old /gps/pos/direction commands did.
/gun/species GCR_H
/gun/phase min
/tracking/verbose 1
/run/beamOn 10
